# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Full HTTPS URL of your cloud tunnel pointing to Odoo (no /mcp suffix)
MCP_URL=https://your-cloud-tunnel-url

# MCP key generated in Odoo:
# Settings > Users > [your user] > Preferences > Account Security > Add MCP Key
# Set scope to "Read Only" for safety.
MCP_KEY=your_mcp_key_here

# Your Telegram user ID — only this ID can trigger Odoo queries
# Find it by messaging @userinfobot on Telegram
AUTHORIZED_TELEGRAM_USER_ID=your_telegram_user_id_here
