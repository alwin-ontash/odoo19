<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="hermes_activity_view_list" model="ir.ui.view">
        <field name="name">hermes.activity.list</field>
        <field name="model">hermes.activity</field>
        <field name="arch" type="xml">
            <list string="Hermes Activities" decoration-success="state == 'success'"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'pending'">
                <field name="date"/>
                <field name="query"/>
                <field name="source"/>
                <field name="tool_called"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hermes_activity_view_form" model="ir.ui.view">
        <field name="name">hermes.activity.form</field>
        <field name="model">hermes.activity</field>
        <field name="arch" type="xml">
            <form string="Hermes Activity">
                <sheet>
                    <group>
                        <group string="Query">
                            <field name="query"/>
                            <field name="source"/>
                            <field name="tool_called"/>
                        </group>
                        <group string="Status">
                            <field name="date"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Response">
                        <field name="response" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="hermes_activity_view_search" model="ir.ui.view">
        <field name="name">hermes.activity.search</field>
        <field name="model">hermes.activity</field>
        <field name="arch" type="xml">
            <search string="Search Activities">
                <field name="query"/>
                <field name="tool_called"/>
                <filter string="Success" name="success" domain="[('state','=','success')]"/>
                <filter string="Error" name="error" domain="[('state','=','error')]"/>
                <filter string="Telegram" name="telegram" domain="[('source','=','telegram')]"/>
                <separator/>
                <filter string="Group by Source" name="group_source" context="{'group_by': 'source'}"/>
                <filter string="Group by Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Group by Date" name="group_date" context="{'group_by': 'date:day'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hermes_activity_action" model="ir.actions.act_window">
        <field name="name">Activity Log</field>
        <field name="res_model">hermes.activity</field>
        <field name="view_mode">list,form</field>
        <field name="path">hermes-activity</field>
        <field name="search_view_id" ref="hermes_activity_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Hermes activities yet
            </p>
            <p>
                Activities are logged automatically when Hermes processes
                queries via the MCP protocol. You can also create entries manually.
            </p>
        </field>
    </record>

</odoo>
